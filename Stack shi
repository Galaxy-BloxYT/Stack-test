TextBoxLeaderTarget.PlaceholderText = "Username do Líder"
TextBoxLeaderTarget.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBoxLeaderTarget.TextSize, TextBoxLeaderTarget.Font = 13, Enum.Font.SourceSans
TextBoxLeaderTarget.Parent = MainFrame
Instance.new("UICorner", TextBoxLeaderTarget).CornerRadius = UDim.new(0, 6)

-- Caixa de Texto para o Index da Alt
local TextBoxIndex = Instance.new("TextBox")
TextBoxIndex.Size = UDim2.new(0.85, 0, 0, 30)
TextBoxIndex.Position = UDim2.new(0.075, 0, 0, 120)
TextBoxIndex.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
TextBoxIndex.Text = "1"
TextBoxIndex.PlaceholderText = "Stack Index (Ex: 1, 2, 3)"
TextBoxIndex.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBoxIndex.TextSize, TextBoxIndex.Font = 13, Enum.Font.SourceSans
TextBoxIndex.Parent = MainFrame
Instance.new("UICorner", TextBoxIndex).CornerRadius = UDim.new(0, 6)

-- Botão Ligar/Desligar
local BtnToggle = Instance.new("TextButton")
BtnToggle.Size = UDim2.new(0.85, 0, 0, 35)
BtnToggle.Position = UDim2.new(0.075, 0, 0, 180)
BtnToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
BtnToggle.Text = "Desativado"
BtnToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnToggle.TextSize, BtnToggle.Font = 14, Enum.Font.SourceSansBold
BtnToggle.Parent = MainFrame
Instance.new("UICorner", BtnToggle).CornerRadius = UDim.new(0, 6)

-- Alternar Modo
BtnLeader.MouseButton1Click:Connect(function()
	isLeader = not isLeader
	if isLeader then
		BtnLeader.Text = "Modo: Líder (Host)"
		BtnLeader.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
		TextBoxLeaderTarget.Visible = false
		TextBoxIndex.Visible = false
	else
		BtnLeader.Text = "Modo: Alt (Seguir)"
		BtnLeader.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		TextBoxLeaderTarget.Visible = true
		TextBoxIndex.Visible = true
	end
end)

-- Toggle Ligar/Desligar
BtnToggle.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	if isRunning then
		BtnToggle.Text = "Ativado"
		BtnToggle.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	else
		BtnToggle.Text = "Desativado"
		BtnToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end)

local function getRoot(char)
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function sanitizeKey(name)
	return string.gsub(name, "[%W]", "")
end

-- Loop Principal
task.spawn(function()
	while true do
		task.wait(0.15)
		if isRunning then
			if isLeader then
				local char = player.Character
				local root = getRoot(char)
				if root then
					-- Pega os 12 componentes do CFrame (X, Y, Z e a matriz de rotação inteira)
					local cfComponents = {root.CFrame:GetComponents()}
					local cleanName = sanitizeKey(player.Name)
					
					pcall(function()
						HttpService:RequestAsync({
							Url = dbUrl .. "lideres/" .. cleanName .. "/CFrame.json",
							Method = "PUT",
							Headers = { ["Content-Type"] = "application/json" },
							Body = HttpService:JSONEncode(cfComponents)
						})
					end)
				end
			else
				local targetLeader = sanitizeKey(TextBoxLeaderTarget.Text)
				local idx = tonumber(TextBoxIndex.Text) or 1
				
				if targetLeader ~= "" then
					local success, response = pcall(function()
						return HttpService:GetAsync(dbUrl .. "lideres/" .. targetLeader .. "/CFrame.json")
					end)
					
					if success and response and response ~= "null" then
						local components = HttpService:JSONDecode(response)
						local char = player.Character
						local root = getRoot(char)
						
						if root and type(components) == "table" and #components >= 12 then
							-- Reconstrói o CFrame do líder com base nos componentes puros
							local leaderCF = CFrame.new(unpack(components))
							
							-- Aplica o CFrame do líder com o offset vertical na altura (Y) mantendo a rotação exata
							local stackedCF = leaderCF + Vector3.new(0, idx * heightOffset, 0)
							root.CFrame = stackedCF
						end
					end
				end
			end
		end
	end
end)
